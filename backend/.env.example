# ============================================================
#  Copie este arquivo para .env e preencha os valores reais:
#    copy .env.example .env       (Windows)
#
#  O .env NUNCA vai para o Git. O .env.example vai.
#  Segredos ficam so no .env de cada dev. Nunca commite, nunca
#  cole em chat de grupo.
# ============================================================

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- Banco de Dados (Neon - nuvem) ---
DB_HOST=seu-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=cole-aqui-a-senha-da-sua-connection-string

# Limite maximo de raio aceito na busca, em km.
RAIO_MAXIMO_KM=50

# --- Autenticacao (Etapa 4) ---
# Segredo usado para ASSINAR e VERIFICAR os tokens JWT.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reaproveite o valor de exemplo abaixo em nenhum ambiente real.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-verdade

# Validade do token de acesso. Formato aceito pela lib jsonwebtoken: "15m", "1h", "7d".
JWT_EXPIRES_IN=1h

# Custo do bcrypt (numero de "rounds"). 10-12 e o padrao recomendado hoje.
# Cada +1 DOBRA o tempo de calculo do hash. Nao suba isso sem medir o impacto.
BCRYPT_SALT_ROUNDS=10

# --- Storage S3-compatible (Etapa 9 - fotos de avaliacao e de perfil) ---
# Obrigatorio SEMPRE, inclusive em desenvolvimento: a API e stateless de
# proposito, nenhum arquivo de usuario pode depender do disco do servidor.
# Use um bucket gratuito tambem para rodar localmente -- por exemplo, um
# bucket no tier free do Cloudflare R2 (https://dash.cloudflare.com > R2):
#   S3_ENDPOINT      = https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION        = auto
#   S3_BUCKET_NAME   = nome do bucket que voce criar no painel do R2
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = credenciais do "R2 API Token"
# Depois de criar o bucket, torne-o publico (Settings > Public access >
# R2.dev subdomain, ou associe um dominio custom) para que as URLs salvas
# no banco (`url_foto_perfil`, fotos de avaliacao) sejam acessiveis pelo
# app sem autenticacao. S3_PUBLIC_URL_BASE e ESSA url publica -- NUNCA o
# mesmo valor de S3_ENDPOINT (o endpoint da API S3 exige assinatura AWS
# ate para leitura, o app nao consegue carregar imagem dali).
S3_ENDPOINT=https://seu-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=nome-do-seu-bucket
S3_ACCESS_KEY_ID=cole-aqui-o-access-key-id
S3_SECRET_ACCESS_KEY=cole-aqui-o-secret-access-key
S3_PUBLIC_URL_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# --- Gateway de Pagamento (migracao 14 - Escrow + Split, Pagar.me) ---
# OPCIONAIS -- diferente de tudo acima, o servidor sobe normalmente sem
# estas duas. So as rotas de /pagamentos (autorizar cobranca, liberar
# split, processar webhook) exigem elas configuradas; o resto do app
# nao e afetado. Use as chaves de TESTE (sandbox) ate o fluxo estar
# validado ponta a ponta -- nunca teste com a chave de producao.
#   PAGARME_API_KEY      = chave secreta da conta (sk_test_... em sandbox,
#                           sk_... em producao) - painel Pagar.me > Chaves
#                           de acesso (https://docs.pagar.me/docs/chaves-de-acesso)
#   PAGARME_WEBHOOK_SECRET = segredo definido ao cadastrar o webhook no
#                           painel do Pagar.me - usado para validar a
#                           assinatura (cabecalho X-Hub-Signature-256) de
#                           cada evento recebido, para ninguem conseguir
#                           forjar um "pagamento autorizado" falso so
#                           descobrindo a URL do endpoint.
PAGARME_API_KEY=sk_test_cole-aqui-sua-chave-de-sandbox
PAGARME_WEBHOOK_SECRET=cole-aqui-o-segredo-do-webhook
