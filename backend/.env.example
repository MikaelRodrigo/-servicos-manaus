# ============================================================
#  Copie este arquivo para .env e preencha DB_PASSWORD:
#    copy .env.example .env       (Windows)
#
#  O .env NUNCA vai para o Git. O .env.example vai.
#  A SENHA fica so no .env de cada dev. Nunca commite, nunca
#  cole em chat de grupo.
# ============================================================

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- Banco de Dados (Neon - nuvem) ---
DB_HOST=ep-old-fog-acwztrpz.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner

# Cole aqui a senha da SUA connection string (comeca com npg_...).
# Esta linha e a unica coisa que voce precisa preencher.
DB_PASSWORD=

# Limite maximo de raio aceito na busca, em km.
RAIO_MAXIMO_KM=50
